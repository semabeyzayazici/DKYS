@model ConfigurationItem

@{
    ViewData["Title"] = "Delete Configuration";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-3 border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">Delete Configuration</h3>
                </div>
                <div class="card-body">
                    <h5 class="text-danger">Are you sure you want to delete this configuration?</h5>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-4 fw-bold">
                            @Html.DisplayNameFor(l => l.Name)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(l => l.Name)
                        </dd>

                        <dt class="col-sm-4 fw-bold">
                            @Html.DisplayNameFor(l => l.Type)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(l => l.Type)
                        </dd>

                        <dt class="col-sm-4 fw-bold">
                            @Html.DisplayNameFor(l => l.Value)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(l => l.Value)
                        </dd>

                        <dt class="col-sm-4 fw-bold">
                            @Html.DisplayNameFor(l => l.IsActive)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(l => l.IsActive)
                        </dd>

                        <dt class="col-sm-4 fw-bold">
                            @Html.DisplayNameFor(l => l.ApplicationName)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(l => l.ApplicationName)
                        </dd>
                    </dl>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                            <input type="submit" value="Delete" class="btn btn-danger" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>