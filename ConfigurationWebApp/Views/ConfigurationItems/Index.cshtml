<!-- Create Button -->
<div class="d-flex mb-2">
    <!-- Search Box -->
    <input type="text" id="searchBox" class="form-control mr-2" placeholder="İsme göre filtrele..." />

    <!-- Create Button -->
    <a href="@Url.Action("Create", "ConfigurationItems")" class="btn btn-primary">Create</a>
</div>
<table class="table" id="configTable">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Value</th>
            <th>IsActive</th>
            <th>Application</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Type</td>
                <td>@item.Value</td>
                <td>@item.IsActive</td>
                <td>@item.ApplicationName</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                </td>
            </tr>
        }
    </tbody>
</table>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $("#searchBox").on("keyup", function () {
        var value = $(this).val().toLowerCase();
        $("#configTable tbody tr").filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
        });
    });
</script>